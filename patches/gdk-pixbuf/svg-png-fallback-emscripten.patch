  *
  * Returns: (nullable): A newly-created pixbuf
  */
+#ifdef __EMSCRIPTEN__
+static gchar *
+wasm_resolve_svg_png (const char *filename)
+{
+        if (filename != NULL && g_str_has_suffix (filename, ".svg")) {
+                gsize len = strlen (filename);
+                gchar *png = g_strdup_printf ("%.*s.png", (int)(len - 4), filename);
+                if (g_file_test (png, G_FILE_TEST_EXISTS))
+                        return png;
+                g_free (png);
+                png = g_strdup_printf ("%.*s.symbolic.png", (int)(len - 4), filename);
+                if (g_file_test (png, G_FILE_TEST_EXISTS))
+                        return png;
+                g_free (png);
+        }
+        return NULL;
+}
+
+static GdkPixbuf *
+wasm_fallback_svg_pixbuf (const char *filename, int width, int height)
+{
+        if (filename != NULL && (g_str_has_suffix (filename, ".svg") || g_str_has_suffix (filename, ".svgz"))) {
+                int w = width > 0 ? width : 16;
+                int h = height > 0 ? height : 16;
+                GdkPixbuf *pb = gdk_pixbuf_new (GDK_COLORSPACE_RGB, TRUE, 8, w, h);
+                if (pb) {
+                        gdk_pixbuf_fill (pb, 0);
+                        return pb;
+                }
+        }
+        return NULL;
+}
+#endif
