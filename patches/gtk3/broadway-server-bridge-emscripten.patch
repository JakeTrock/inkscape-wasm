@@ -832,7 +836,10 @@
 static void *
 map_named_shm (char *name, gsize size)
 {
-#ifdef G_OS_UNIX
+#ifdef __EMSCRIPTEN__
+  /* wasm: buffer lives in the app's heap, registered by name */
+  return bridge_shm_lookup (name, size);
+#elif defined(G_OS_UNIX)
 
   int fd;
   void *ptr;
@@ -1302,6 +1309,13 @@
   GInetAddress *inet_address;
   GSocketAddress *socket_address;
 
+#ifdef __EMSCRIPTEN__
+  /* wasm: no HTTP/socket service — the bridge connects the app and the
+   * browser client in-memory. */
+  server = g_object_new (BROADWAY_TYPE_SERVER, NULL);
+  return server;
