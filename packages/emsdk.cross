[binaries]
c = 'emcc'
cpp = 'em++'
ar = 'emar'
strip = 'emstrip'
pkg-config = 'pkg-config'

[properties]
needs_exe_wrapper = true
cpp_args = ['-fexceptions', '-frtti']
# every wasm link pulls our single-threaded pthread/DNS supplement
c_link_args = ['-lpthread']
cpp_link_args = ['-lpthread']

[host_machine]
system = 'emscripten'
cpu_family = 'wasm32'
cpu = 'wasm32'
endian = 'little'
