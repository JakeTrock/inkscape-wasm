<?xml version="1.0" encoding="UTF-8"?>
<!-- Minimal deterministic profile: disable the welcome screen and splash so
     headless batch runs never block on UI. Used by BOTH the wasm build
     (staged at /home/web_user) and the native golden generator. -->
<inkscape version="1.4.4" xmlns:inkscape="http://www.inkscape.org/namespaces/inkscape">
  <group id="theme" iconTheme="multicolor" defaultIconTheme="multicolor" symbolicIcons="1"
         preferDarkTheme="1" darkTheme="1" symbolicDefaultBaseColors="1" symbolicDefaultHighColors="0"/>
  <group id="options">
    <group id="boot" showwelcome="0" showsplash="0"/>
    <group id="wheelscroll" value="12"/>
    <group id="zoomincrement" value="1.15"/>
    <group id="defaultwindowsize" value="2"/>
  </group>
  <group id="dialogs">
    <group id="import" ask="0" ask_svg="0" link="embed" import_mode_svg="include" forcexdpi="1" scale="auto"/>
  </group>
</inkscape>
